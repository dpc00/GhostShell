[
    {
        "id": "tools",
        "children":
        [
            {
                "caption": "Ai Terminal",
                "mnemonic": "A",
                "id": "ai-terminal",
                "children":
                [
                    {
                        "caption": "Launch Agent…",
                        "command": "ai_terminal_launcher"
                    },
                    {
                        "caption": "All Agent History…",
                        "command": "ai_terminal_history"
                    },
                    { "caption": "-" },
                    {
                        "caption": "Open Profile…",
                        "command": "ai_terminal_select_profile"
                    },
                    {
                        "caption": "Default Profile",
                        "command": "ai_terminal_open_here"
                    },
                    {
                        "caption": "Refresh Usage & Quota",
                        "command": "ai_terminal_refresh_usage"
                    },
                    { "caption": "-" },
                    {
                        "caption": "Set Working Directory",
                        "command": "ai_terminal_set_working_directory"
                    },
                    {
                        "caption": "Clear Working Directory",
                        "command": "ai_terminal_clear_working_directory"
                    },
                    { "caption": "-" },
                    {
