__pycache__/
*.pyc
.venv/
.idea/
.pytest*/
pytest-cache-files-*/
.test-tmp/
.codex-test-tmp-*/
.tmp/
.session-baton.json


# Built binary artifact -- keep on disk (required at runtime) but don't track in git.
*.dll
*.sublime-color-scheme

# Credentials must never be committed: the secrets settings file backing
# `$secret:NAME` references (see _resolve_secret_refs), plus the credential and
# env files the agent CLIs themselves write.
ai_terminal_secrets.sublime-settings
*secrets*.sublime-settings
.credentials.json
auth.json
.env
.env.*
.mimo*/

# omp (oh-my-pi) project config -- .omp/mcp.json carries real MCP server
# credentials (API keys, tokens) in plaintext, same category as the other
# credential files above.
.omp/

# Session recordings/transcripts are verbatim terminal output (keys, source).
*.cast

# Fully machine-generated by AiTerminalSyncAgentProfilesCommand -- rewritten
# wholesale from local CLI detection, never hand-edited.
ai_terminal_agents.sublime-settings

# Local editor state and Package Control-generated installation metadata.
*.sublime-workspace
package-metadata.json
*.sublime-package
