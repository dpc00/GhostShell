    // ai_terminal — ConPTY terminal for Sublime Text (currently Claude Code).
    // Edit this file to retune without source edits; changes apply live
    // (no plugin reload needed): the history deque is swapped in place and
    // the resize poller picks up new column bounds within ~750ms.
    // Number of lines kept in scrollback history (the `history` deque).
    // This is the minimap-fill knob: at font 14 / 685px viewport, 300 fills
    // the minimap exactly -- rigorously tested, deliberate (the whole
    // buffer top-to-bottom is always visible in the minimap at once). Do
    // NOT raise this to "fix" trim-induced viewport jumps -- that's what
    // trim_paused + _compensate_trim_scroll are for (2026-08-18); this
    // number is a display-fit constant, not a jumpiness knob. Retune by
    // eye against the minimap when you change the window height or font
    // size. Decreasing it may improve performance.
    // Live: changing this swaps the live deque (trims oldest if smaller).
    // libghostty-vt max_scrollback is bytes, not lines (ghostty#12769);
    // ghostty_engine converts this line cap at terminal_new.
    "scrollback_history_size": 300,
    // Kill switch for the auto-scroll/follow/pin machinery (_scroll_to_bottom,
    // _pin_terminal_viewport, _pin_viewport_rest, the render loop's do_follow
    // write, and _clamp_vp_loop's rest-pin branches) -- every viewport write
    // in ai_terminal.py goes through the single _set_viewport choke point,
    // gated on this. False = the user's own scroll position (wheel, drag,
    // keyboard) is never overwritten by any of that machinery.
    // Per user directive (2026-08-18): added because that machinery had
    // accumulated enough interacting special cases (footer-size assumptions,
    // TUI-vs-shell branches, pan/latch state machines) that every targeted
    // fix broke a different case live -- this let the whole pile be disabled
    // at once while it was being redesigned rather than patched further.
    // Live: read fresh on every viewport write, no reload needed.
    "scroll_manipulation_enabled": true,
    // Redraw only the lines that changed (as Terminus does) instead of
    // rewriting the whole tab on every screen update. Rewriting everything
    // makes Sublime move the view by itself, which shows up as the text
    // jumping up and down while typing. Lines added or removed at the end are
    // inserted or erased there; nothing else is touched.
    // False = always rewrite the whole tab (the behaviour before 2026-09-22).
    // Live: read fresh on every redraw, no reload needed.
    "line_diff_render_enabled": true,
    // Keep the tab from losing rows at the bottom once they have been shown,
    // like a real terminal whose screen height never changes. Without it the
    // tab shrinks and grows with an app's status footer, and the view jumps
    // up and down on every status update. A new tab still starts compact.
    // False = drop every trailing blank row on every redraw (as before
    // 2026-09-22, and as Terminus does).
    // Live: read fresh on every redraw, no reload needed.
    "steady_screen_height_enabled": true,
    // When old scrollback lines are dropped while the tab is following new
    // output, move the view up to keep the same text on screen. The follow
    // code then moves it straight back down, which shows as the text jumping
    // up and down on status updates, so this is off by default.
    // True = the behaviour before 2026-09-22.
    // Live: read fresh on every redraw, no reload needed.
    "compensate_trim_while_following": false,
    // Environment shared by every terminal profile. Keep installation paths
    // here once instead of copying them into each provider's hook config.
    "shared_spawn_env": {},
    // claude --model gemini-2.5-pro
    // Env vars applied to the spawned terminal process (merged on top of
    // os.environ). Swap or add agent-specific vars here without editing the
    // plugin. Applied on the next _spawn: close and reopen the ai_terminal
    // tab to pick up. Keys and values must be strings.
    //
    // CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN=1 -- force the classic main-screen
    // renderer (no alternate-screen fullscreen TUI). Claude Code's default
    // fullscreen mode paints a fixed ~60-row matrix on the alt screen,
