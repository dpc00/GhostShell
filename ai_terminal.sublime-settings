    // Record every ai_terminal session as an asciicast v3 file under
    // ~/data/logs/ai_terminal_asciinema_casts_for_troubleshooting_rendering.
    // Set false to disable recording globally. Legacy per-profile
    // AI_TERMINAL_LOG_LINES values remain supported but are deprecated;
    // prefer a per-profile "record_asciicast" boolean when an override is
    // actually needed. Resolution is profile override, then global, then true.
    "record_asciicast": true,
    // ai_terminal — ConPTY terminal for Sublime Text (currently Claude Code).
    // Edit this file to retune without source edits; changes apply live
    // (no plugin reload needed): the history deque is swapped in place and
    // the resize poller picks up new column bounds within ~750ms.
    // Number of lines kept in scrollback history (the `history` deque).
    // This is the minimap-fill knob: at font 14 / 685px viewport, 300 fills
    // the minimap exactly -- rigorously tested, deliberate (the whole
    // buffer top-to-bottom is always visible in the minimap at once). Do
    // NOT raise this to "fix" trim-induced viewport jumps -- that's what
    // trim_paused + _compensate_trim_scroll are for (2026-08-18); this
    // number is a display-fit constant, not a jumpiness knob. Retune by
    // eye against the minimap when you change the window height or font
    // size. Decreasing it may improve performance.
    // Live: changing this swaps the live deque (trims oldest if smaller).
    "scrollback_history_size": 100000,
    // Environment shared by every terminal profile. Keep installation paths
    // here once instead of copying them into each provider's hook config.
    "shared_spawn_env": {
        "STLOGS_ENDPOINT": "http://127.0.0.1:9511/event",
        "STLOGS_HOME": "$env:STLOGS_HOME",
        "STLOGS_LOG_ROOT": "$env:USERPROFILE\\data\\logs"
    },
    // claude --model gemini-2.5-pro
    // Env vars applied to the spawned terminal process (merged on top of
    // os.environ). Swap or add agent-specific vars here without editing the
    // plugin. Applied on the next _spawn: close and reopen the ai_terminal
    // tab to pick up. Keys and values must be strings.
    //
    // CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN=1 -- force the classic main-screen
    // renderer (no alternate-screen fullscreen TUI). Claude Code's default
    // fullscreen mode paints a fixed ~60-row matrix on the alt screen,
    // bypassing terminal scrollback -- so only the last screenful of
    // conversation is ever visible and ST folding damages the matrix. The
    // classic renderer writes scrolling output to the primary buffer, where
    // our screen grid + history deque capture the full conversation and ST
    // folding works on real scrolling text. Added in Claude Code v2.1.132;
    // takes precedence over CLAUDE_CODE_NO_FLICKER and the tui setting.
    // See https://code.claude.com/docs/en/env-vars
    //
    // CLAUDE_CODE_AI_TERMINAL_SENTINEL -- propagation marker proving the
    // spawn_env dict reaches the child process. Harmless; drop it if you
    // don't need the test.
    "spawn_env": {
        // "AI_TERMINAL_LOG_LINES": "1",
        // "GEMINI_PROMPT_QUEUE": "false"
        // "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "80",
        // "CLAUDE_CODE_AI_TERMINAL_SENTINEL": "propagated",
        // "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "1600000",
        // "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "1600000",
        // "CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN": "1",
        // "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "2000000",
        // "OLLAMA_MODEL":"glm-5.2:cloud"
        // "ANTHROPIC_MODEL": "claude-sonnet-5",
        // "ANTHROPIC_VERTEX_PROJECT_ID": "project-67efc385-8bb5-493f-a81",
        // "CLAUDE_CODE_USE_VERTEX": "1",
        // "CLOUD_ML_REGION": "global",
        // "GEMINI_API_KEY": "",
        // "GOOGLE_CLOUD_LOCATION":"global",
        // "GOOGLE_CLOUD_PROJECT":"project-67efc385-8bb5-493f-a81",
        // "GOOGLE_PROJECT_NUMBER":"782908338549",
    },
    // Path to a markdown file whose contents are prepended to the system
    // prompt (above the context files). Edit the file directly to change
    // the wrapper text — the file is plain markdown, no JSON escaping.
    // Default location is ai_sdk_prompt.md alongside this settings file.
    "system_prompt_wrapper_file": "C:\\Users\\donal\\projects\\SText\\ai_sdk_prompt.md",
    // Host ST caret is ALWAYS off for terminal views (see _terminal_view).
    // Claude/OpenCode paint the cursor with reverse fg/bg (SGR 7) in the cell
    // stream — same model as Terminus. Do not turn on block_caret; a visible
    // host caret becomes a second cursor and looks like an off-by-one.
    // These keys are ignored if present (kept for documentation only):
    // "block_caret": false,
    // "caret_style": "solid",
    // "caret_extra_width": 0,
    // DEAD KEY, kept only so this comment isn't lost: "terminal_font" was
    // never actually read by ai_terminal.py -- the plugin reads "font_face"/
    // "font_size" (see _term_render / lines ~3866-3880), which were never
    // set anywhere in this file. So every terminal tab, including agents
    // whose TUIs paint block-element glyphs (Copilot's startup mascot, box-
    // drawing borders, etc.), has been running on whatever ST's *global*
    // font_face is, not Cascadia Code -- confirmed 2026-09-05 after a
    // garbled-character report on GitHub Copilot's tab turned out to be a
    // font coverage gap. Real key below.
    "terminal_font": "Cascadia Code",
    // Font for ai_terminal tabs only (this is the key the plugin actually
    // reads). Must be a monospace font with full box-drawing (U+2500-
    // U+257F), block-element (U+2580-U+259F), and misc TUI symbol coverage
    // (U+23BF, U+23F8, U+2733, U+273B, U+2802, U+2B1D). Cascadia Code ships
    // with Windows 10+ and has all of these. A profile can override this
    // with its own "font_face"/"font_size".
    "font_face": "Cascadia Code",
    // How often (minutes) to re-poll each provider's usage/quota endpoint so
    // the figures in the launcher and menus do not go stale mid-session. The
    // sweep uses the OAuth tokens the CLIs already persisted and spends no
    // inference quota, but it does hit the network, so the interval is a knob.
    // Set 0 to disable and rely on the load-time sweep plus the manual
    // "Ai: Refresh Usage & Quota" command. Values below 1 are clamped to 1.
    // Changes apply immediately; no reload needed.
    "usage_refresh_minutes": 20,
    // Master switch for credential-backed provider usage discovery. False
    // prevents startup, periodic, and manual scans, including local credential
    // reads and token refreshes. An already-running provider fetch may finish
    // (and persist rotated tokens), but subsequent fetches are cancelled.
    // Usage observed from terminal output remains available. This does not
    // control the native DLL download or network access by launched CLIs.
    "usage_scan_enabled": true,
    // user_owns_caret_enabled: term._user_owns_caret -- lets a manual click/
    // selection outside the live prompt row permanently hold the ST caret in
    // place instead of the render loop re-snapping it to the PTY cursor every
    // frame. False = the render loop always re-syncs the caret to the PTY
    // cursor, every frame, unconditionally.
    "user_owns_caret_enabled": false
}
