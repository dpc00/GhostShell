{
    // Raw terminal output retained by detachable brokers for reconstruction
    // after Sublime Text restarts. The old 262144-byte broker default was too
    // small for Codex's ANSI repaint frames and could restore only a fragment.
    // 2 MiB targets roughly 300 recent displayed lines for crash recovery,
    // not full-session archival. May be overridden per profile; GhostShell
    // clamps it to 1-256 MiB.
    "broker_scrollback_bytes": 2097152,
    // --- Cursor/caret deviation-from-Terminus bisection gates (2026-08-21) ---
    // Terminus's entire cursor model (verified directly against its real
    // source): take the PTY's raw cursor position, add the scrollback
    // offset, place the ST caret there. No remapping, no pinning, no click-
    // to-position synthesis, no manual-selection override. Everything below
    // is a GhostShell addition on top of that baseline, each independently
    // gatable so a command-line cursor/editing regression can be bisected by
    // disabling all of them (the settings below), retesting, then flipping
    // ONE back to true at a time and retesting until the offender surfaces.
    // Live: read fresh every render, no reload needed.
    //
    // caret_footer_pinning_enabled: caret.py's adjust_display_caret --
    // remaps/pins the display caret when the app parks its hardware cursor
    // off the live prompt row (built to hide Claude's footer-repaint
    // flicker). False = raw hardware (y, x) used directly, Terminus-style.
    // RESTORED TO TRUE 2026-08-21: disabling this fed trim_display_rows
    // (ai/CURSOR_SYSTEM_HISTORY.md item 6, not itself gated) a raw cy that
    // jumps to Claude's footer -- trim_display_rows treats a cursor parked
    // away from content as "drop everything below the last real row," which
    // with an unpinned cy meant real scrollback content, not just blank
    // padding, got dropped (reported: 300 lines missing, tab down to ~22-26
    // lines and still shrinking). That report predates this flip and was
    // never reproduced against current trim_display_rows (see ai_terminal.py
    // _do_render's 2026-08-27 note); investigated and flipped to false after
    // live-verifying the raw-cursor path in a genuinely isolated process
    // (portable ST + git worktree, see ai/TODO.md "Terminus rewrite, stage
    // 1") -- multi-line cursor position, a real permission prompt, and
    // PageUp/PageDown all confirmed correct with this off. Revert to true
    // only if scrollback loss actually reproduces again.
    "caret_footer_pinning_enabled": false,
    // click_to_cursor_fallback_enabled: _route_click_to_cursor_fallback --
    // synthesizes Left/Right keypresses so a mouse click repositions the
    // app's real PTY-side cursor for agents with no DEC mouse-tracking
    // receiver (Claude Code, Gemini, Antigravity, Codex, Kimi, Kiro, Junie).
    // False = clicking only moves ST's local selection, same as raw PTY
    // click-to-position has always meant for these agents.
    "click_to_cursor_fallback_enabled": false,
    // Close a terminal tab automatically ~1.5s after its process exits
    // (crash, clean quit, or the user typing `exit`) -- a dead tab that just
    // sits there isn't normal terminal-app behavior. Default true. A profile
    // can set "close_tab_on_exit": false to keep a tab open after exit (e.g.
    // to read a final error/update message at leisure).
    "close_tab_on_exit": true,
    // Path for the color-scheme-scope diagnostic log. The plugin appends scope-
    // registration and flush events here. Edit to redirect, or set null to disable
    // color-scheme logging entirely. Changes take effect after plugin reload.
    "color_scheme_log_path": "~/data/logs/developer_diagnostics_and_runtime_server_error_logs/color_scheme.log",
    // Files whose content is appended to the system prompt on every bridge
    // startup. Each is read and prepended with its basename as a markdown
    // header, then joined with '---'. This is how the AI gets its working
    // context: agents.md (the lobby), router.md (project map), and the
    // project's CLAUDE.md (project-specific rules). Edit this list to add
    // or remove context. Restart the bridge to pick up changes.
    "context_files": [
        // "C:\\Users\\donal\\agents.md",
        // "C:\\Users\\donal\\router.md",
        // "C:\\Users\\donal\\projects\\SText\\agents.md",
        // "C:\\Users\\donal\\projects\\SText\\CLAUDE.md"
    ],
    // Live status-bar readout (follow/tui/cols×rows/vp_y) instead of reading
    // console prints after the fact -- see ai/TODO.md 2026-08-27 session.
    // Off by default (extra text in every terminal tab's status bar
    // otherwise). Read fresh every render tick, no reload needed.
    "debug_status_bar_enabled": false,
    // The default profile to run if no profile name is explicitly requested
    "default_profile": "Claude",
    // Every terminal survives independently of Sublime (see
    // docs/DETACHABLE_SESSIONS.md) and is reachable through Recover Session
    // and Open in Windows Terminal -- not just profiles that opt in by hand.
    // A profile can set "detachable": false to opt a specific one out (e.g. a
    // throwaway shell not worth a background broker process for). RESTORED
    // 2026-09-06: this key was missing from the last live copy of this file,
    // which silently made every profile without its own explicit
    // "detachable": true non-detachable (ai_terminal.py defaults false when
    // this top-level key is absent) -- affected Antigravity, Bash, Claude
    // --chrome, Claude → Cloud, Claude →⇢⇨ Ollama, Claude →⇢⇨ Ollama --chrome,
    // Cody, Codex →⇢⇨ Ollama, Dos Console, dsh, Pybackup Go TUI. See
    // docs/DETACHABLE_SESSIONS.md.
    "detachable": true,
    // Mouse drag vs text selection when a TUI enables xterm mouse tracking:
    //   true  = mouse-first: plain drag → PTY (Grok scrollbar/UI); Shift/Ctrl-drag → ST select
    //   false = copy-first: drags → ST select (copy between agent tabs). Short *taps* and
    //           multi-clicks still go to the PTY when the app enabled mouse tracking
    //           (Grok trust dialog / buttons). Wheel still works. Live-read each drag.
    //           Default false = copy-first.
    "drag_forwards_by_default": false,
    // fast_caret_patch_enabled: AiTerminalRenderCommand's diff-patch shortcut
    // -- instead of replacing the whole view text every frame, it writes only
    // the handful of cells that changed (built for paint_host_cursor's 0-2-
    // cell glyph move). Its safety assumption is that cursor row/column stay
    // stable frame to frame, which caret_footer_pinning_enabled normally
    // guarantees; with that disabled, the raw hardware cursor can jump to
    // Claude's footer and back, changing how much padding a row gets even
    // when real content hasn't -- the diff-patch then writes a few
    // characters at the wrong offsets (a visible splatter that self-heals on
    // the next full-buffer render). False = always do the full-buffer
    // replace, no partial patching, Terminus-style (Terminus does not have
    // an equivalent optimization at all).
    // REVERTED TO FALSE 2026-08-21, same session: character-splatter
    // corruption still reproduced with caret_footer_pinning_enabled back on,
    // disproving the "only unstable cx/cy" theory above -- the diff-patch is
    // unreliable on its own, not just in combination with the other gate.
    // Leave false: correctness over the cosmetic footer jiggle.
    "fast_caret_patch_enabled": false,
    // Snap-to-bottom can skip the last N buffer rows so a TUI whose
    // footer height wobbles does not jiggle the viewport. Default 0
    // (follow the real last line). Override per profile.
    "follow_ignore_trailing_lines": 0,
    // Ignore the TUI's alt-screen (DECSET 1049) toggle so our renderer keeps
    // real ST scrollback. Default true = scrollback on. Set false to let a
    // TUI take over the view with a fixed fullscreen matrix (loses scrollback).
    "force_main_screen": true,
    // host_cursor_paint_enabled: render.py's paint_host_cursor -- synthesizes
    // a visible block/bar/underline/hollow glyph or reverse-video cell on top
    // of the plain rendered text. False = rely solely on the real ST caret
    // (still positioned per caret_footer_pinning_enabled above) plus
    // whatever reverse-video the app itself already sends.
    "host_cursor_paint_enabled": false,
    // Legacy fallback keys (fully supported for backward compatibility)
    // argv list used to spawn the terminal program. Default runs Claude Code
    // via the Ollama local proxy (127.0.0.1:11434, glm-5.2:cloud). Swap to e.g.
    //   ["claude"]                          -- Claude Code direct against Anthropic API
    //   ["cmd", "/c", "opencode"]            -- OpenCode instead of Claude Code
    //   ["cmd", "/c", "claude"]              -- Claude Code on Windows (native cmd shim)
    // Applied on the next _spawn: close and reopen the ai_terminal tab to pick up.
    "launch_command": [
        "cmd.exe"
    ],
    // Keep a plain-text, agent-readable transcript of every ai_terminal
    // session under ~/data/logs/ai_terminal_session_text_logs -- one line
    // appended the instant it permanently scrolls out of the live viewport
    // (never a duplicate, no ANSI), plus whatever's still on-screen flushed
    // when the tab closes. Point an agent at this file to review what
    // happened in a past session, regardless of what CLI/agent was running
    // in that tab -- this operates below the application layer, so it works
    // identically for cmd, bash, PowerShell, or any of the agent profiles.
    // Set false to disable globally. A profile can set "log_tab_text": false
    // to opt a specific one out.
    "log_tab_text": true,
    "max_columns": null,
    // Floor and ceiling on the auto-sized terminal width in characters.
    // cols is computed from the viewport width; min_columns is the lower
    // bound, max_columns caps it (null = no cap). The renderer's no-horizontal-
    // scrollbar math (cols = int(usable_w/cw) - 3) still applies inside these
    // bounds. Live: the resize poller picks up new bounds within ~750ms.
    "min_columns": 20,
    // Floor on the auto-sized terminal height in rows. No artificial minimum
    // beyond 1 -- rows must never exceed the pane's actual computed height,
    // or trailing blank PTY rows can hide real content on scroll-to-bottom
    // (confirmed: broke Claude Code's TUI after typing).
    "min_rows": 1,
    // Rename the ST tab to the app's OSC 0/2 window title (ssh, vim, npm
    // scripts, etc. all set one). Default false: the existing profile-name-
    // based tab titling is relied upon and must not change unless opted in.
    // A profile can set "osc_title_updates_tab": true to opt in individually
    // instead of flipping this globally. Live: takes effect on the next
    // title change, no reload needed.
    "osc_title_updates_tab": false,
    // Every configured profile is eligible when its launch executable exists.
    // ai_terminal learns current quota state from real terminal output and grays
    // a profile after a provider reports exhaustion. It never probes a provider,
    // opens OAuth, or spends quota merely to populate the menus.
    // Configured terminal/shell profiles for SText.
    // This allows SText to work as a multi-console terminal launcher.
    "profiles": {
        "Amp": {
            // Sourcegraph's Amp CLI. Requires login before showing any
            // interactive session -- declining exits the process entirely
            // (confirmed live 2026-09-04, cast
            // ai_2026-09-04_171108_819080: "Login cancelled..." then
            // \x1b[?9001l\x1b[?1004l and exit). Mouse/page-key behavior
            // unconfirmed without authenticating -- safe defaults only.
            //
            // NO_ANIMATION=1: Amp's idle splash is a continuously-redrawing
            // dot-shaded logo (confirmed 2026-09-06, cast
            // ai_2026-09-06_030330_004578.cast: 8193 events / 4.37M chars
            // over ~3 minutes of pure idle animation before any real work
            // happened). Disabling it keeps a session's .cast from
            // ballooning to multiple MB before the agent does anything.
            "detachable": true,
            "launch_command": [
                "amp"
            ],
            "spawn_env": {
                "NO_ANIMATION": "1"
            }
        },
        "Antigravity": {
            // Google Antigravity CLI. Shim installed to
            // C:\Users\donal\AppData\Local\agy\bin\agy.exe -- not on PATH
            // until the shell that launches ST is restarted, so use the
            // full path (same reasoning as the Junie profile below).
            // Mouse tracking: never enables DEC ?1000/1002/1003 (checked all
            // 5 recorded asciicast sessions, 2026-08-11) -- no PTY-side
            // receiver for a forwarded click; mouse_handling would be a no-op.
            // page_keys_to_pty: its own `?` shortcuts panel explicitly lists
            // "pgdown, shift+down  Page down" / "pgup, shift+up  Page up"
            // (confirmed live 2026-08-13).
            // CORRECTION 2026-09-05: the "zero DECSET 1049 observed" claim
            // below is now contradicted -- a fresh sweep of 6 real sessions
            // shows Antigravity DOES enter/exit real alt-screen (6/6). So
            // this may actually be the ordinary force_main_screen-masking
            // category (same as Grok/Qwen/OpenCode) rather than "inline TUI
            // owns page keys regardless of alt-screen." Either way
            // page_keys_to_pty stays true -- the `?` panel's own documented
            // binding is reason enough on its own. No mouse tracking in any
            // of the 6 fresh sessions either, so mouse_handling stays off.
            // Kept below for history, not as fact: Runs in Inline rendering
            // mode inside ai_terminal (zero DECSET 1049 observed), so this
            // isn't the force_main_screen masking bug -- it's the same
            // category jcode's source code confirmed: an inline-rendered
            // TUI can still bind PageUp/PageDown for its own scroll
            // regardless of alt-screen use, and ST's default
            // steal-for-native-page behavior breaks that just the same.
            "launch_command": [
                "C:\\Users\\donal\\AppData\\Local\\agy\\bin\\agy.exe"
            ],
            "page_keys_to_pty": true,
            "spawn_env": {}
        },
        "Auggie": {
            // Augment Code's Auggie CLI. Requires OAuth login (opens a
            // browser) before showing any interactive session. Confirmed
            // live 2026-09-04 (cast ai_2026-09-04_171042_555380): only an
            // ASCII-art startup banner + win32-input-mode handshake
            // (?9001h) captured before the login prompt -- no DEC mouse
            // tracking, no alt-screen seen. Safe defaults only.
            "detachable": true,
            "launch_command": [
                "auggie"
            ],
            "spawn_env": {}
        },
        "Bash": {
            // Pin Git Bash — bare "bash" resolves to the WSL App Execution
            // Alias (WindowsApps\\bash.exe, 0-byte stub) which precedes Git on PATH.
            "launch_command": [
                "C:\\Program Files\\Git\\bin\\bash.exe",
                "-l"
            ],
            "spawn_env": {}
        },
        "Claude": {
            "detachable": true,
            // Mouse tracking: only ever sends the disable form (?1000/1002/
            // 1003l) at startup, never enables -- confirmed across 100+
            // recorded asciicast sessions (2026-08-11). No PTY-side receiver
            // for a forwarded click.
            // follow_ignore_trailing_lines deliberately EXCLUDES that many
            // trailing rows from the auto-scroll target -- raising it hides
            // more of the bottom (footer/statusline), it does not fix
            // visibility. A prior attempt at 6 (up from 2) was meant to stop
            // scroll churn from ccstatusline's footer recomputing every
            // render, but confirmed live 2026-08-27 that it costs 4 lines of
            // real bottom content (337 -> 333) -- the actual statusline
            // going unreadable is worse than the churn it was trading away.
            // Reverted to 0: always follow true bottom, footer included.
            // Confirmed live 2026-08-27: 0 puts the true last line (339)
            // exactly at the bottom, correct. -1 (overshoot) was only a
            // one-off diagnostic to double-check nothing was clipped; not
            // needed as the steady-state value.
            "follow_ignore_trailing_lines": 0,
            "launch_command": [
                "claude"
